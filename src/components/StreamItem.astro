---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	formatStreamDate,
	formatWordCount,
	type StreamItem,
} from '../lib/stream';
import { projects } from '../projects.config';

interface Props {
	item: StreamItem;
	heroImage?: ImageMetadata;
}

const { item, heroImage } = Astro.props;
const project = item.project
	? projects.find((entry) => entry.slug === item.project)
	: undefined;
const titleHref = item.type === 'link' && item.linkUrl ? item.linkUrl : item.href;
const titleTarget = item.type === 'link' && item.linkUrl ? '_blank' : undefined;
const titleRel = titleTarget ? 'noopener noreferrer' : undefined;
const footerLinks = [
	...(project
		? [{ href: `/blog/project/${project.slug}`, label: project.name }]
		: []),
	...item.tags.map((tag) => ({
		href: `/blog/tag/${encodeURIComponent(tag)}`,
		label: tag,
	})),
];
---

<article class="stream-item">
	<h3 class="stream-title">
		<a href={titleHref} target={titleTarget} rel={titleRel}>{item.title}</a>
		{item.viaUrl && item.viaTitle && (
			<span class="stream-via">
				{' '}(via <a href={item.viaUrl} target="_blank" rel="noopener noreferrer">{item.viaTitle}</a>)
			</span>
		)}
		{item.viaUrl && !item.viaTitle && (
			<span class="stream-via">
				{' '}(<a href={item.viaUrl} target="_blank" rel="noopener noreferrer">via</a>)
			</span>
		)}
	</h3>

	{heroImage && item.type === 'entry' && (
		<a href={item.href} class="stream-hero">
			<Image src={heroImage} alt={item.title} widths={[720]} sizes="(min-width: 768px) 720px, 100vw" />
		</a>
	)}

	<div class="prose stream-body" set:html={item.excerptHtml} />

	{item.hasMore && (
		<p class="stream-more">
			<a href={item.href}>[... {formatWordCount(item.wordCount)}]</a>
		</p>
	)}

	<div class="stream-footer">
		<a href={item.href} class="stream-permalink" aria-label={`Permalink: ${item.title}`}>
			{formatStreamDate(item.pubDate)}
		</a>
		{footerLinks.map((link) => (
			<span>
				<span class="stream-meta-sep" aria-hidden="true"> · </span>
				<a href={link.href} class="stream-tag">{link.label}</a>
			</span>
		))}
	</div>
</article>

<style>
	.stream-item {
		padding-bottom: 2rem;
		margin-bottom: 2rem;
		border-bottom: 1px solid var(--border-color);
	}

	.stream-item:last-child {
		border-bottom: 0;
		margin-bottom: 0;
		padding-bottom: 0;
	}

	.stream-title {
		font-size: 1.35rem;
		font-weight: 700;
		line-height: 1.3;
		margin-bottom: 0.75rem;
	}

	.stream-title a {
		color: var(--accent);
		text-decoration: none;
	}

	.stream-title a:hover {
		color: var(--accent-hover);
		text-decoration: underline;
		text-decoration-color: var(--accent);
	}

	.stream-via {
		font-weight: 400;
		font-size: 0.95rem;
		color: var(--text-secondary);
	}

	.stream-via a {
		color: var(--text-secondary);
		text-decoration: underline;
	}

	.stream-hero {
		display: block;
		margin: 0 0 1rem;
	}

	.stream-hero img {
		width: 100%;
		height: auto;
		border-radius: 0.5rem;
	}

	.stream-body :global(p:last-child) {
		margin-bottom: 0;
	}

	.stream-more {
		margin-top: 0.75rem;
		font-size: 0.95rem;
	}

	.stream-more a {
		color: var(--accent);
		text-decoration: none;
	}

	.stream-more a:hover {
		color: var(--accent-hover);
		text-decoration: underline;
	}

	.stream-footer {
		margin-top: 0.85rem;
		font-size: 0.8rem;
		font-family: ui-monospace, "SF Mono", Monaco, Consolas, monospace;
		color: var(--text-secondary);
	}

	.stream-permalink,
	.stream-tag {
		color: var(--text-secondary);
		text-decoration: none;
	}

	.stream-permalink:hover,
	.stream-tag:hover {
		color: var(--accent);
	}
</style>
